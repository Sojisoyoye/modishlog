# ModishLog — local development environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is listed in .gitignore.

# ── PostgreSQL (Docker Compose local DB) ──────────────────────────────────────
# Used by docker-compose.yml to initialise the local postgres container.
POSTGRES_PASSWORD=modishlog_dev

# Full async connection URL used by the FastAPI backend.
DATABASE_URL=postgresql+asyncpg://modishlog:modishlog_dev@db:5432/modishlog

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32-output
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:4200"]

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info

# ── FX / Exchange-rate API ────────────────────────────────────────────────────
# Free tier of open.er-api.com works without a key.
# Sign up at https://www.exchangerate-api.com for a paid key (higher rate limits).
FX_API_KEY=
FX_API_URL=https://api.example.com/fx
FX_LIVE_API_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_TTL_HOURS=4

# ── Anthropic AI ──────────────────────────────────────────────────────────────
# Required for AI Recommendations, Price Suggestions, and Quick Quote features.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Override only if routing through a proxy (e.g. cliproxy). Leave blank for direct API.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── POS migration (pos_migrate.py only) ───────────────────────────────────────
# Credentials for the live UltimatePOS instance at pos.virtualrx.com.ng.
# Only required when running: docker compose exec backend python scripts/pos_migrate.py
# Never needed for normal app operation.
POS_USERNAME=
POS_PASSWORD=
