# Production environment variables — copy to .env.production, fill all values, NEVER commit
# Generate a strong SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=modishlog
POSTGRES_USER=modishlog
POSTGRES_PASSWORD=<strong-random-password>
DATABASE_URL=postgresql+asyncpg://modishlog:<password>@db/modishlog

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=<min-32-char-random-hex>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=info
APP_VERSION=1.0.0
UPLOAD_DIR=/app/uploads

# ── CORS — production domain only ─────────────────────────────────────────────
CORS_ORIGINS=["https://modishlog.com"]

# ── Docker image ──────────────────────────────────────────────────────────────
BACKEND_IMAGE=ghcr.io/sojisoyoye/modishlog/backend:production

# ── External APIs ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_BASE_URL=https://api.anthropic.com
FX_API_KEY=<your-fx-api-key>
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_LIVE_API_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_TTL_HOURS=4

# ── Error tracking (optional) ─────────────────────────────────────────────────
SENTRY_DSN=<your-sentry-dsn>
