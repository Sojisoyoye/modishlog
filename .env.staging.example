# ModishLog STAGING environment variables
# These are set as GitHub Actions secrets and injected at deploy time.
# NEVER commit real values to git.

# ── Neon PostgreSQL (staging branch) ──────────────────────────────────────────
# Format: postgresql+asyncpg://user:pass@ep-xxx-pooler.region.neon.tech/neondb?sslmode=require
# SSL is auto-configured from sslmode=require in the URL — no extra flag needed.
STAGING_DATABASE_URL=postgresql+asyncpg://neondb_owner:CHANGE_ME@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
STAGING_SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Vercel deployment URL (set after first Vercel deploy)
STAGING_CORS_ORIGINS=https://modishlog-staging.vercel.app,https://modishlog-git-main-sojisoyoye.vercel.app

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=staging
LOG_LEVEL=info

# ── FX / Exchange-rate API ────────────────────────────────────────────────────
FX_API_KEY=
FX_API_URL=https://api.example.com/fx
FX_LIVE_API_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_TTL_HOURS=4

# ── Anthropic AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Set to https://cliproxy.modishstandard.com if routing through the proxy,
# or leave as the default https://api.anthropic.com for direct API access.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── POS migration (pos_migrate.py only — run once on the server) ──────────────
# Credentials for the live UltimatePOS instance at pos.virtualrx.com.ng.
# Run inside the staging container:
#   docker compose exec backend python scripts/pos_migrate.py
# Set as GitHub Actions secrets or export manually on the server before running.
POS_USERNAME=CHANGE_ME
POS_PASSWORD=CHANGE_ME

# ── Hetzner deploy (for GitHub Actions SSH deploy) ───────────────────────────
# IPv4 address of the Hetzner server
HETZNER_HOST=YOUR_SERVER_IP
# Private SSH key that can log into the server as root
HETZNER_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...

# ── GHCR (GitHub Container Registry) ─────────────────────────────────────────
# GitHub PAT with packages:read and packages:write scopes
GHCR_TOKEN=ghp_...

# ── Vercel ────────────────────────────────────────────────────────────────────
VERCEL_TOKEN=...
VERCEL_ORG_ID=...
VERCEL_PROJECT_ID=...

# ── Staging backend URL ───────────────────────────────────────────────────────
# Public URL of the Hetzner server (e.g. http://YOUR_SERVER_IP or a domain)
# ⚠️  Must be set in TWO places:
#   1. GitHub Actions secret (used by CI to reference the URL in logs)
#   2. Vercel project environment variable (used by vercel.json buildCommand
#      to substitute __STAGING_API_URL__ in environment.staging.ts at build time)
#      → Vercel dashboard → Project → Settings → Environment Variables
STAGING_API_URL=http://YOUR_SERVER_IP:8000
