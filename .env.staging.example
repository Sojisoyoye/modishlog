# ModishLog STAGING environment variables.
# NEVER commit real values to git.
#
# Two DISTINCT places these live, historically conflated in this file (fixed
# 2026-09-10, task 218/254 — see DEPLOYMENT.md): variables below the first
# section are read by docker-compose.staging.yml from a plain .env file that
# lives ONLY on the Hetzner server at /root/modishlog/.env, unprefixed
# (deploy-staging.yml never passes them as GitHub Actions secrets — only
# GHCR_TOKEN and IMAGE_TAG are). The STAGING_ prefix further down is for the
# GitHub Actions secrets the workflow itself actually reads.

# ── Server-local /root/modishlog/.env on the Hetzner box (unprefixed) ─────────

# ── Neon PostgreSQL (staging branch) ──────────────────────────────────────────
# Format: postgresql+asyncpg://user:pass@ep-xxx-pooler.region.neon.tech/neondb?sslmode=require
# SSL is auto-configured from sslmode=require in the URL — no extra flag needed.
DATABASE_URL=postgresql+asyncpg://neondb_owner:CHANGE_ME@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Redis (shared rate-limit state across gunicorn workers) ──────────────────
# Internal service name from docker-compose.staging.yml — leave as default
# unless Redis is hosted externally.
REDIS_URL=redis://redis:6379

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
# Fernet key rotation (task #225) -- comma-separated, newest key first.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Empty falls back to deriving a key from SECRET_KEY. See docs/deployment.md's
# "Secret rotation" section for the actual rotation procedure.
FERNET_KEYS=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Vercel deployment URL (set after first Vercel deploy). JSON-array string,
# matching how Settings parses it (same convention as docker-compose.prod.yml).
CORS_ORIGINS=["https://modishlog-staging.vercel.app","https://modishlog-git-main-sojisoyoye.vercel.app"]

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=staging
LOG_LEVEL=info

# ── FX / Exchange-rate API ────────────────────────────────────────────────────
FX_API_KEY=
FX_API_URL=https://api.example.com/fx
FX_LIVE_API_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_TTL_HOURS=4

# ── Anthropic AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Set to https://cliproxy.modishstandard.com if routing through the proxy,
# or leave as the default https://api.anthropic.com for direct API access.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Transactional email (Resend) ───────────────────────────────────────────────
# Get a real key from https://resend.com/api-keys — an empty key means the app
# silently logs emails instead of sending them (email verification and
# forgot-password links will not reach users).
RESEND_API_KEY=<your-resend-api-key>
EMAILS_FROM_EMAIL=noreply@staging.modishlog.com
EMAILS_FROM_NAME=ModishLog
FRONTEND_URL=https://staging.modishlog.com

# ── GitHub Actions secrets (repo Settings → Secrets, NOT the server .env) ─────
# Everything from here down is read by deploy-staging.yml itself via
# secrets.*, not by docker-compose.staging.yml on the server.

# ── POS migration (pos_migrate.py only — run once on the server) ──────────────
# Credentials for the live UltimatePOS instance at pos.virtualrx.com.ng.
# Run inside the staging container:
#   docker compose exec backend python scripts/pos_migrate.py
# Set as GitHub Actions secrets or export manually on the server before running.
POS_USERNAME=CHANGE_ME
POS_PASSWORD=CHANGE_ME

# ── Hetzner deploy (for GitHub Actions SSH deploy) ───────────────────────────
# IPv4 address of the Hetzner server
HETZNER_HOST=YOUR_SERVER_IP
# Private SSH key that can log into the server as root
HETZNER_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...

# ── GHCR (GitHub Container Registry) ─────────────────────────────────────────
# GitHub PAT with packages:read and packages:write scopes
GHCR_TOKEN=ghp_...

# ── Vercel ────────────────────────────────────────────────────────────────────
VERCEL_TOKEN=...
VERCEL_ORG_ID=...
VERCEL_PROJECT_ID=...

# ── Staging backend URL ───────────────────────────────────────────────────────
# Public URL of the Hetzner server (e.g. http://YOUR_SERVER_IP or a domain)
# ⚠️  Must be set in TWO places:
#   1. GitHub Actions secret (used by CI to reference the URL in logs)
#   2. Vercel project environment variable (used by vercel.json buildCommand
#      to substitute __STAGING_API_URL__ in environment.staging.ts at build time)
#      → Vercel dashboard → Project → Settings → Environment Variables
STAGING_API_URL=http://YOUR_SERVER_IP:8000
