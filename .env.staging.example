# ModishLog STAGING environment variables
# These are set as GitHub Actions secrets and injected at deploy time.
# NEVER commit real values to git.

# ── Neon PostgreSQL (staging branch) ──────────────────────────────────────────
# Format: postgresql+asyncpg://user:pass@ep-xxx-pooler.region.neon.tech/neondb?sslmode=require
STAGING_DATABASE_URL=postgresql+asyncpg://neondb_owner:CHANGE_ME@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
STAGING_SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# Vercel deployment URL (set after first Vercel deploy)
STAGING_CORS_ORIGINS=https://modishlog-staging.vercel.app,https://modishlog-git-main-sojisoyoye.vercel.app

# ── External APIs ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
FX_API_KEY=
FX_API_URL=https://api.example.com/fx
PERPLEXITY_API_KEY=

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=staging
LOG_LEVEL=info

# ── Azure (for GitHub Actions deploy) ─────────────────────────────────────────
# Service principal JSON from: az ad sp create-for-rbac --sdk-auth
AZURE_CREDENTIALS={"clientId":"...","clientSecret":"...","subscriptionId":"8b21f152-e36b-4d53-9b88-70fc38d906bc","tenantId":"..."}
AZURE_RESOURCE_GROUP=rg-modishlog-staging
AZURE_CONTAINER_APP_NAME=modishlog-backend-staging
# Reuses heimpath's shared CAE — Azure student tier allows only 1 per region
AZURE_CONTAINER_APP_ENV=cae-heimpath
AZURE_CAE_RESOURCE_GROUP=rg-heimpath-shared

# ── GHCR (GitHub Container Registry) ─────────────────────────────────────────
# GitHub PAT with packages:read and packages:write scopes
GHCR_TOKEN=ghp_...

# ── Vercel ────────────────────────────────────────────────────────────────────
VERCEL_TOKEN=...
VERCEL_ORG_ID=...
VERCEL_PROJECT_ID=...

# ── Staging backend URL (set after first Azure deploy) ────────────────────────
# e.g. https://modishlog-backend-staging.XXXXXX.germanywestcentral.azurecontainerapps.io
# ⚠️  Must be set in TWO places:
#   1. GitHub Actions secret (used by CI to reference the URL in logs)
#   2. Vercel project environment variable (used by vercel.json buildCommand
#      to substitute __STAGING_API_URL__ in environment.staging.ts at build time)
#      → Vercel dashboard → Project → Settings → Environment Variables
STAGING_API_URL=https://modishlog-backend-staging.CHANGE_ME.germanywestcentral.azurecontainerapps.io
