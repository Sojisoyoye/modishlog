# Uploads — UPLOAD_DIR defaults to /app/uploads, which under the local
# docker-compose bind mount (./backend:/app) lands at backend/uploads/, not
# root /uploads/ — both patterns are needed or local extraction caches
# (real business data, from data_import jobs) end up tracked by git.
/uploads/
backend/uploads/

